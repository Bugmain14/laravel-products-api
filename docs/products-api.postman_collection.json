                  "key": "page",
                  "value": "1",
                  "description": "Página.",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Resultados por página, entre 1 y 100 (por defecto 15).",
                  "disabled": true
